DEVICE_ID=vault-pi-01
OWNER_NAME=Mr Sarkar
OWNER_FINGERPRINT_ID=1

VAULT_TZ=Asia/Kolkata
WINDOW_START=10:00
WINDOW_END=11:00

BUTTON_PIN=17
RELAY_PIN=27
RELAY_ACTIVE_HIGH=false
SIREN_PIN=22
LED_GREEN_PIN=23
LED_RED_PIN=24

FINGERPRINT_PORT=/dev/ttyUSB0
FINGERPRINT_BAUD=57600
FINGERPRINT_TIMEOUT_S=10

FACE_MODEL_PATH=owner_face_model.yml
FACE_CASCADE_PATH=/usr/share/opencv4/haarcascades/haarcascade_frontalface_default.xml
FACE_CONFIDENCE_MAX=70
FACE_TIMEOUT_S=8

UNLOCK_SECONDS=5
SIREN_SECONDS=8
LOCKOUT_ATTEMPTS=3
LOCKOUT_WINDOW_S=300
LOCKOUT_SECONDS=900

# Must match INGEST_API_KEY in backend/.env
BACKEND_URL=http://localhost:3000
INGEST_API_KEY=some-long-random-string
BACKEND_TIMEOUT_S=5

# Servo release latch (pigpio PWM) -- runs alongside the relay above
SERVO_PIN=12
SERVO_LOCKED_PULSE_US=500
SERVO_OPEN_PULSE_US=1500

# RTC (DS3231, I2C bus 1)
RTC_I2C_ADDR=0x68

# TFT display (ST7735, hardware SPI0 CE0 + these two GPIO)
TFT_DC_PIN=5
TFT_RST_PIN=6

# Tamper accelerometer (ADXL345, I2C bus 1)
ADXL_I2C_ADDR=0x53
TAMPER_ACCEL_THRESHOLD_G=0.5
TAMPER_POLL_INTERVAL_S=0.3
# Optional -- leave unset if you have no lid switch wired
LID_SWITCH_PIN=

# SIM800L SMS alert (soft serial via pigpio)
SIM_TX_PIN=21
SIM_RX_PIN=20
SMS_ALERT_NUMBERS=+918122370613,+917601068528

# Static fallback location until a GPS module is wired
DEFAULT_LAT=12.9716
DEFAULT_LNG=77.5946
