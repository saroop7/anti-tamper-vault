DEVICE_ID=vault-pi-01
OWNER_NAME=Mr Sarkar
OWNER_FINGERPRINT_ID=1

VAULT_TZ=Asia/Kolkata
WINDOW_START=10:00
WINDOW_END=11:00

BUTTON_PIN=17
RELAY_PIN=27
RELAY_ACTIVE_HIGH=false
SIREN_PIN=22
LED_GREEN_PIN=23
LED_RED_PIN=24

FINGERPRINT_PORT=/dev/ttyUSB0
FINGERPRINT_BAUD=57600
FINGERPRINT_TIMEOUT_S=10

FACE_MODEL_PATH=owner_face_model.yml
FACE_CASCADE_PATH=/usr/share/opencv4/haarcascades/haarcascade_frontalface_default.xml
FACE_CONFIDENCE_MAX=70
FACE_TIMEOUT_S=8

UNLOCK_SECONDS=5
SIREN_SECONDS=8
LOCKOUT_ATTEMPTS=3
LOCKOUT_WINDOW_S=300
LOCKOUT_SECONDS=900

# Must match INGEST_API_KEY in backend/.env
BACKEND_URL=http://localhost:3000
INGEST_API_KEY=some-long-random-string
BACKEND_TIMEOUT_S=5
